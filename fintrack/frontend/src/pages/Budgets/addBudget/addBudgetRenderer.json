{
  "entity_name": "budgets",
  "components": [
    {
      "field_type": "dropdownComponent",
      "field_id": "category_id",
      "entity_field_name": "category_id",
      "width": 12,
      "label": "Category",
      "placeholder": "Select category",
      "required": true,
      "listname": "transaction_category",
      "optCode": "id",
      "optValue": "name"
    },
    {
      "field_type": "textfield",
      "field_id": "amount",
      "entity_field_name": "amount",
      "width": 12,
      "label": "Budget Amount",
      "name": "amount",
      "type": "number",
      "placeholder": "e.g. 5000",
      "required": true,
      "regex": "^[0-9]{1,12}(\\.[0-9]{1,2})?$"
    },
    {
      "field_type": "datePickerComponent",
      "field_id": "start_date",
      "entity_field_name": "start_date",
      "width": 12,
      "label": "Month",
      "required": true
    }
  ]
}
