{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "baseUrl": "src",
    "paths": {
      "@/styles/*": ["css/*"],
      "@/components/*": ["components/*"],
      "@/utils/*": ["utils/*"],
      "@/app/*": ["app/*"],
      "@/config/*": ["config/*"],
      "@/redux/*": ["redux/*"],
      "@/indexeddb/*": ["indexeddb/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.js", "**/*.jsx"],
  "exclude": ["node_modules", "dist", "build", ".trash"]
}
